# ============================================================
# ENVIRONMENT VARIABLES - Copy to .env and configure
# ============================================================

# Application
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cv_generator
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# Authentication (Clerk)
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Storage (AWS S3 or Cloudflare R2)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=cv-generator-pdfs
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_key
# STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com  # For Cloudflare R2

# PDF Generation
PDF_TIMEOUT=30000
PDF_MAX_CONCURRENT=3

# Rate Limiting
RATE_LIMIT_PDF_FREE=5
RATE_LIMIT_PDF_PRO=50
RATE_LIMIT_API=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Monitoring (Optional)
SENTRY_DSN=
